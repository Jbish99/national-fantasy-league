# Template only. The real .env is written by `neon init` and is git-ignored.

# Neon connection strings (written by `neon init`).
#   DATABASE_URL           pooled connection: the Streamlit app uses this
#   DATABASE_URL_UNPOOLED  direct connection: ETL loads and schema changes use this
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Current season's Sleeper league. Older seasons are found by walking previous_league_id.
SLEEPER_CURRENT_LEAGUE_ID=1334317252626882560
